{
  "expo": {
    "name": "CoffeeChain",
    "slug": "coffee-chain",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/Icon_stand_in.png",
    "userInterfaceStyle": "light",
    "scheme": "coffeechain",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.coffeechain.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.coffeechain.app"
    },
    "web": {
      "favicon": "./src/assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ]
  }
}
